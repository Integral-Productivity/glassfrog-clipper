{
  "manifest_version": 3,
  "name": "GlassFrog Clipper",
  "version": "0.0.1",
  "description": "Clip the page you're on into GlassFrog as a tension, action, or project.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://api.glassfrog.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Clip to GlassFrog"
  },
  "commands": {
    "quick-capture": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Clip this page to GlassFrog with no further input"
    }
  }
}
