{
  "name": "glassfrog-clipper",
  "version": "0.0.1",
  "private": true,
  "description": "Clip the page you're on into GlassFrog as a tension, action, or project — without losing your train of thought.",
  "license": "GPL-3.0-or-later",
  "author": "Kraig Parkinson <kraigparkinson@integralproductivity.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Integral-Productivity/glassfrog-clipper-chrome-extension.git"
  },
  "type": "module",
  "scripts": {
    "build": "tsup && cp -R public/. dist/",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/**/*.test.ts'",
    "build:safari": "tsup && node scripts/build-safari.mjs",
    "build:all": "npm run build && node scripts/build-safari.mjs"
  },
  "dependencies": {
    "@integral-productivity/glassfrog": "^0.6.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.270",
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
